Panels:
  - Class: rviz_common/Displays
    Name: Displays
  - Class: rviz_common/Selection
    Name: Selection
  - Class: rviz_common/Tool Properties
    Name: Tool Properties
  - Class: rviz_common/Views
    Name: Views
Visualization Manager:
  Class: ""
  Displays:
    - Class: rviz_default_plugins/Grid
      Enabled: true
      Name: Grid
    - Class: rviz_default_plugins/Map
      Enabled: true
      Name: Map
      Topic: /map
      Value: true
    - Class: rviz_default_plugins/TF
      Enabled: true
      Name: TF
      Show Arrows: true
      Show Axes: true
      Show Names: true
    - Class: rviz_default_plugins/LaserScan
      Enabled: true
      Name: Raw Laser
      Topic: /scan
      Value: true
      Style: Points
      Size (Pixels): 2
      Color: 255; 80; 80
    - Class: rviz_default_plugins/LaserScan
      Enabled: true
      Name: Filtered Laser
      Topic: /scan_filtered
      Value: true
      Style: Points
      Size (Pixels): 2
      Color: 80; 255; 80
    - Class: rviz_default_plugins/Path
      Enabled: true
      Name: Planned Path (Hybrid A*)
      Topic: /planned_path
      Value: true
      Color: 0; 255; 255
      Line Width: 0.08
    - Class: rviz_default_plugins/Path
      Enabled: true
      Name: Nav2 Local Plan
      Topic: /plan
      Value: true
      Color: 255; 255; 0
      Line Width: 0.05
    - Class: rviz_default_plugins/PointCloud2
      Enabled: true
      Name: Predicted Obstacles Cloud
      Topic: /tracked_obstacles_cloud
      Value: true
      Style: Flat Squares
      Size (Pixels): 5
      Color: 255; 0; 255
    - Class: rviz_default_plugins/MarkerArray
      Enabled: true
      Name: Search Expansions
      Topic: /search_expansions
      Value: true
  Enabled: true
  Global Options:
    Background Color: 48; 48; 48
    Fixed Frame: map
  Name: root
  Tools:
    - Class: rviz_default_plugins/MoveCamera
    - Class: rviz_default_plugins/Interact
    - Class: rviz_default_plugins/Select
    - Class: rviz_default_plugins/SetInitialPose
      Topic: /initialpose
    - Class: rviz_default_plugins/SetGoal
      Topic: /goal_pose
  Views:
    Current:
      Class: rviz_default_plugins/Orbit
      Distance: 18
      Focal Point:
        X: 0
        Y: 0
        Z: 0
      Pitch: 0.8
      Yaw: 0.7
Window Geometry:
  Width: 1600
  Height: 900
