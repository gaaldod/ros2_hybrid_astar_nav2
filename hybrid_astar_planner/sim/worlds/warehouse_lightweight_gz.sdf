<?xml version="1.0"?>
<sdf version="1.7">
  <world name="warehouse_lightweight">
    <include>
      <uri>model://sun</uri>
    </include>

    <!-- Simple static ground plane -->
    <include>
      <uri>model://ground_plane</uri>
    </include>

    <!-- A lightweight box model that will be driven by a trajectory plugin -->
    <actor name="moving_box">
      <pose>0 0 0.35 0 0 0</pose>
      <skin>
        <filename>model://box/meshes/box.dae</filename>
        <scale>1 1 1</scale>
      </skin>
      <animation name="move_y">
        <interpolate_x>true</interpolate_x>
      </animation>
      <script>
        <trajectory id="0" type="walking">
          <waypoint>
            <time>0</time>
            <pose>0 -8 0.35 0 0 0</pose>
          </waypoint>
          <waypoint>
            <time>32</time>
            <pose>0 8 0.35 0 0 0</pose>
          </waypoint>
          <waypoint>
            <time>64</time>
            <pose>0 -8 0.35 0 0 0</pose>
          </waypoint>
        </trajectory>
      </script>
    </actor>

    <!-- lighting / physics tuned for lightweight sim -->
    <scene>
      <ambient>0.4 0.4 0.4 1</ambient>
      <background>0.7 0.7 0.7 1</background>
    </scene>

    <physics type='ode'>
      <max_step_size>0.001</max_step_size>
      <real_time_update_rate>1000</real_time_update_rate>
    </physics>

  </world>
</sdf>
