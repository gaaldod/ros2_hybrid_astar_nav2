<?xml version="1.0" ?>
<sdf version="1.6">
  <world name="aws_small_warehouse_dynamic">
    <gravity>0 0 -9.8</gravity>
    <physics type="ode" name="default_physics">
      <max_step_size>0.001</max_step_size>
      <real_time_factor>1</real_time_factor>
      <real_time_update_rate>1000</real_time_update_rate>
    </physics>

    <scene>
      <ambient>0.35 0.35 0.35 1.0</ambient>
      <background>0.7 0.7 0.7 1.0</background>
      <shadows>true</shadows>
    </scene>

    <!-- Core AWS warehouse assets (credit in README). -->
    <model name="aws_warehouse_roof">
      <include>
        <uri>model://aws_robomaker_warehouse_RoofB_01</uri>
      </include>
      <pose>0 0 0 0 0 0</pose>
    </model>

    <model name="aws_warehouse_walls">
      <include>
        <uri>model://aws_robomaker_warehouse_WallB_01</uri>
      </include>
      <pose>0 0 0 0 0 0</pose>
    </model>

    <model name="aws_warehouse_ground">
      <include>
        <uri>model://aws_robomaker_warehouse_GroundB_01</uri>
      </include>
      <pose>0 0 -0.090092 0 0 0</pose>
    </model>

    <model name="shelf_f_01">
      <include>
        <uri>model://aws_robomaker_warehouse_ShelfF_01</uri>
      </include>
      <pose>-5.795143 -0.956635 0 0 0 0</pose>
    </model>

    <model name="shelf_e_01">
      <include>
        <uri>model://aws_robomaker_warehouse_ShelfE_01</uri>
      </include>
      <pose>4.73156 0.57943 0 0 0 0</pose>
    </model>

    <model name="shelf_e_02">
      <include>
        <uri>model://aws_robomaker_warehouse_ShelfE_01</uri>
      </include>
      <pose>4.73156 -4.827049 0 0 0 0</pose>
    </model>

    <model name="shelf_d_01">
      <include>
        <uri>model://aws_robomaker_warehouse_ShelfD_01</uri>
      </include>
      <pose>4.73156 -1.242668 0 0 0 0</pose>
    </model>

    <model name="shelf_d_02">
      <include>
        <uri>model://aws_robomaker_warehouse_ShelfD_01</uri>
      </include>
      <pose>4.73156 -6.750542 0 0 0 0</pose>
    </model>

    <!-- Static clutter -->
    <model name="clutter_a_01">
      <include>
        <uri>model://aws_robomaker_warehouse_ClutteringA_01</uri>
      </include>
      <pose>5.708138 8.616844 -0.017477 0 0 0</pose>
    </model>

    <model name="clutter_c_01">
      <include>
        <uri>model://aws_robomaker_warehouse_ClutteringC_01</uri>
      </include>
      <pose>3.324959 3.822449 -0.012064 0 0 1.563871</pose>
    </model>

    <model name="pallet_jack">
      <include>
        <uri>model://aws_robomaker_warehouse_PalletJackB_01</uri>
      </include>
      <pose>-0.276098 -9.481944 0.023266 0 0 0</pose>
    </model>

    <light name="warehouse_light" type="point">
      <pose>0 0 9 0 0 0</pose>
      <diffuse>0.5 0.5 0.5 1</diffuse>
      <specular>0.2 0.2 0.2 1</specular>
      <attenuation>
        <range>80</range>
        <constant>0.3</constant>
        <linear>0.01</linear>
        <quadratic>0.001</quadratic>
      </attenuation>
      <cast_shadows>true</cast_shadows>
    </light>

    <!-- 3 scripted moving obstacles for detection / tracking tests. -->
    <actor name="moving_obstacle_1">
      <pose>-2.5 -7.0 0 0 0 0</pose>
      <skin>
        <filename>file://media/models/walk.dae</filename>
        <scale>1.0</scale>
      </skin>
      <animation name="walking">
        <filename>file://media/models/walk.dae</filename>
        <scale>1.0</scale>
        <interpolate_x>true</interpolate_x>
      </animation>
      <script>
        <loop>true</loop>
        <delay_start>0.5</delay_start>
        <auto_start>true</auto_start>
        <trajectory id="0" type="walking">
          <waypoint><time>0.0</time><pose>-2.5 -7.0 0 0 0 0.0</pose></waypoint>
          <waypoint><time>5.0</time><pose>-2.5 -1.0 0 0 0 1.57</pose></waypoint>
          <waypoint><time>10.0</time><pose>-2.5 -7.0 0 0 0 -1.57</pose></waypoint>
        </trajectory>
      </script>
    </actor>

    <actor name="moving_obstacle_2">
      <pose>1.0 5.0 0 0 0 0</pose>
      <skin>
        <filename>file://media/models/walk.dae</filename>
        <scale>1.0</scale>
      </skin>
      <animation name="walking">
        <filename>file://media/models/walk.dae</filename>
        <scale>1.0</scale>
        <interpolate_x>true</interpolate_x>
      </animation>
      <script>
        <loop>true</loop>
        <delay_start>1.5</delay_start>
        <auto_start>true</auto_start>
        <trajectory id="0" type="walking">
          <waypoint><time>0.0</time><pose>1.0 5.0 0 0 0 0.0</pose></waypoint>
          <waypoint><time>6.0</time><pose>6.5 5.0 0 0 0 3.14</pose></waypoint>
          <waypoint><time>12.0</time><pose>1.0 5.0 0 0 0 0.0</pose></waypoint>
        </trajectory>
      </script>
    </actor>

    <actor name="moving_obstacle_3">
      <pose>0.0 0.0 0 0 0 0</pose>
      <skin>
        <filename>file://media/models/walk.dae</filename>
        <scale>1.0</scale>
      </skin>
      <animation name="walking">
        <filename>file://media/models/walk.dae</filename>
        <scale>1.0</scale>
        <interpolate_x>true</interpolate_x>
      </animation>
      <script>
        <loop>true</loop>
        <delay_start>0.0</delay_start>
        <auto_start>true</auto_start>
        <trajectory id="0" type="walking">
          <waypoint><time>0.0</time><pose>0.0 -2.0 0 0 0 0.0</pose></waypoint>
          <waypoint><time>4.0</time><pose>2.0 0.0 0 0 0 1.57</pose></waypoint>
          <waypoint><time>8.0</time><pose>0.0 2.0 0 0 0 3.14</pose></waypoint>
          <waypoint><time>12.0</time><pose>-2.0 0.0 0 0 0 -1.57</pose></waypoint>
          <waypoint><time>16.0</time><pose>0.0 -2.0 0 0 0 0.0</pose></waypoint>
        </trajectory>
      </script>
    </actor>
  </world>
</sdf>
